{
    "auth": {
        "identityProviders": {
            "azureActiveDirectory": {
                "registration": {
                    "openIdIssuer": "https://login.microsoftonline.com/6f0631cd-785f-4219-9cd9-b2a624be0039/v2.0",
                    "clientIdSettingName": "AAD_CLIENT_ID",
                    "clientSecretSettingName": "AAD_CLIENT_SECRET"
                }
            }
        }
    },
    "routes":  [
                   {
                       "route":  "/.auth/login/aad",
                       "allowedRoles":  [
                                            "anonymous"
                                        ]
                   },
                   {
                       "route":  "/.auth/logout",
                       "allowedRoles":  [
                                            "anonymous"
                                        ]
                   },
                   {
                       "route":  "/*",
                       "allowedRoles":  [
                                            "portal_user"
                                        ]
                   }
               ],
    "responseOverrides":  {
                              "401":  {
                                          "redirect":  "/.auth/login/aad",
                                          "statusCode":  302
                                      },
                              "403":  {
                                          "rewrite":  "/unauthorized.html",
                                          "statusCode":  403
                                      }
                          }
}
